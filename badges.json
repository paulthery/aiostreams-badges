{
  "badges": [
    {"label": "T1", "match": "\\bT1$", "fields": ["rseMatched"], "group": "tier", "color": "#0E0E0E", "background": "#C6A56B", "border": "#C6A56B"},
    {"label": "T2", "match": "\\bT2$", "fields": ["rseMatched"], "group": "tier", "color": "#EDE8DF", "border": "#EDE8DF"},
    {"label": "T3", "match": "\\bT3$", "fields": ["rseMatched"], "group": "tier", "color": "#8C8C8C", "border": "#4A4A4A"},
    {"label": "LQ", "match": "^(LQ|LQ Title|Anime LQ|Asian LQ|Upscaled|FR FastSUB|FR LQ .*)$", "fields": ["rseMatched"], "color": "#8C8C8C", "border": "#8C8C8C"},
    {"label": "4K", "match": "^(2160p|4k)$", "fields": ["resolution"], "group": "res", "color": "#0E0E0E", "background": "#EDE8DF", "border": "#EDE8DF"},
    {"label": "1080", "match": "^1080p$", "fields": ["resolution"], "group": "res", "color": "#EDE8DF", "border": "#EDE8DF"},
    {"label": "720", "match": "^720p$", "fields": ["resolution"], "group": "res", "color": "#8C8C8C", "border": "#4A4A4A"},
    {"label": "REMUX", "match": "remux", "fields": ["quality"], "group": "src", "color": "#C6A56B", "border": "#C6A56B"},
    {"label": "BLURAY", "match": "^blu-?ray$", "fields": ["quality"], "group": "src", "color": "#EDE8DF", "border": "#4A4A4A"},
    {"label": "WEB-DL", "match": "^web-?dl$", "fields": ["quality"], "group": "src", "color": "#8C8C8C", "border": "#4A4A4A"},
    {"label": "WEBRIP", "match": "^web-?rip$", "fields": ["quality"], "group": "src", "color": "#8C8C8C", "border": "#4A4A4A"},
    {"label": "HDR+DV", "match": "HDR\\+DV|(?=.*\\bHDR)(?=.*\\bDV\\b)", "fields": ["visualTags"], "group": "hdr", "image": "https://raw.githubusercontent.com/paulthery/aiostreams-badges/main/hdr/hdrdv.png?v=6", "border": "#C6A56B"},
    {"label": "HDR10+", "match": "HDR10\\+", "fields": ["visualTags"], "group": "hdr", "image": "https://raw.githubusercontent.com/paulthery/aiostreams-badges/main/hdr/hdr10plus.png?v=6", "border": "#C6A56B"},
    {"label": "HDR", "match": "\\bHDR(10)?\\b", "fields": ["visualTags"], "group": "hdr", "image": "https://raw.githubusercontent.com/paulthery/aiostreams-badges/main/hdr/hdr10.png?v=6", "border": "#C6A56B"},
    {"label": "DV", "match": "\\bDV\\b", "fields": ["visualTags"], "group": "hdr", "image": "https://raw.githubusercontent.com/paulthery/aiostreams-badges/main/hdr/dv.png?v=6", "border": "#C6A56B"},
    {"label": "HLG", "match": "^HLG$", "fields": ["visualTags"], "group": "hdr", "image": "https://raw.githubusercontent.com/paulthery/aiostreams-badges/main/hdr/hlg.png?v=6", "border": "#8C8C8C"},
    {"label": "SDR", "match": "^(?!.*(HDR|\\bDV\\b|\\bDoVi\\b|HLG|Dolby[ ._-]?Vision)).+$", "fields": ["filename"], "group": "hdr", "image": "https://raw.githubusercontent.com/paulthery/aiostreams-badges/main/hdr/sdr.png?v=6", "border": "#8C8C8C"},
    {"label": "IMAX", "match": "\\bimax\\b", "fields": ["visualTags", "editions", "filename"], "color": "#EDE8DF", "border": "#4A4A4A"},
    {"label": "ATMOS", "match": "atmos", "fields": ["audioTags"], "group": "audio", "color": "#C6A56B", "border": "#C6A56B"},
    {"label": "DTS:X", "match": "dts[:-]?x", "fields": ["audioTags"], "group": "audio", "color": "#C6A56B", "border": "#4A4A4A"},
    {"label": "TRUEHD", "match": "truehd", "fields": ["audioTags"], "group": "audio", "color": "#EDE8DF", "border": "#4A4A4A"},
    {"label": "DTS-HD MA", "match": "dts-hd ?ma", "fields": ["audioTags"], "group": "audio", "color": "#EDE8DF", "border": "#4A4A4A"},
    {"label": "DD+", "match": "^dd\\+$", "fields": ["audioTags"], "group": "audio", "color": "#8C8C8C", "border": "#4A4A4A"},
    {"label": "7.1", "match": "^7\\.1$", "fields": ["audioChannels"], "group": "ch", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "5.1", "match": "^5\\.1$", "fields": ["audioChannels"], "group": "ch", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "HEVC", "match": "^(HEVC|H\\.?265|x265)$", "fields": ["encode"], "group": "enc", "image": "https://raw.githubusercontent.com/paulthery/aiostreams-badges/main/codec/h265.png?v=6", "border": "#C6A56B"},
    {"label": "AV1", "match": "^AV1$", "fields": ["encode"], "group": "enc", "image": "https://raw.githubusercontent.com/paulthery/aiostreams-badges/main/codec/av1.png?v=6", "border": "#C6A56B"},
    {"label": "H.264", "match": "^(AVC|H\\.?264|x264)$", "fields": ["encode"], "group": "enc", "image": "https://raw.githubusercontent.com/paulthery/aiostreams-badges/main/codec/h264.png?v=6", "border": "#8C8C8C"},
    {"label": "VP9", "match": "^VP9$", "fields": ["encode"], "group": "enc", "image": "https://raw.githubusercontent.com/paulthery/aiostreams-badges/main/codec/vp9.png?v=6", "border": "#8C8C8C"},
    {"label": "10BIT", "match": "\\b10[ ._-]?bit\\b", "fields": ["filename"], "image": "https://raw.githubusercontent.com/paulthery/aiostreams-badges/main/codec/10bit.png?v=6", "border": "#C6A56B"},
    {"label": "VFF", "match": "\\b(TRUEFRENCH|VFF|VF2)\\b", "fields": ["filename", "folderName"], "group": "fr", "color": "#EDE8DF", "background": "#2A2723", "border": "#2A2723"},
    {"label": "VFQ", "match": "\\b(VFQ|VQ)\\b", "fields": ["filename", "folderName"], "group": "fr", "color": "#EDE8DF", "background": "#2A2723", "border": "#2A2723"},
    {"label": "VF", "match": "^French$", "fields": ["languages"], "group": "fr", "color": "#EDE8DF", "background": "#2A2723", "border": "#2A2723"},
    {"label": "VOSTFR", "match": "\\b(VOST(FR)?|SUBFRENCH)\\b", "fields": ["filename", "folderName"], "group": "fr", "color": "#8C8C8C", "background": "#1C1B19", "border": "#1C1B19"},
    {"label": "VF+VO", "match": "\\bmulti\\b|^dual audio$", "fields": ["languages", "filename", "folderName"], "group": "lang", "color": "#EDE8DF", "background": "#2A2723", "border": "#2A2723"},
    {"label": "VO", "match": "^(English|Original)$", "fields": ["languages"], "group": "lang", "color": "#EDE8DF", "background": "#2A2723", "border": "#2A2723"},
    {"label": "FINAL CUT", "match": "^(?!(The[ ._-])?Final[ ._-]Cut[ ._-](19|20)\\d\\d).*\\bfinal[ ._-]?cut\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "DIR CUT", "match": "^Director's Cut$|\\bdirector'?s?[ ._-]?cut\\b", "fields": ["editions", "filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "REDUX", "match": "\\bredux\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "ROGUE CUT", "match": "\\brogue[ ._-]?cut\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "ULTIMATE", "match": "^Ultimate Edition$|\\bultimate[ ._-]?(cut|edition)\\b", "fields": ["editions", "filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "EXTENDED", "match": "^Extended Edition$|version[ ._-]?longue", "fields": ["editions", "filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "ROADSHOW", "match": "\\broadshow\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "UNRATED", "match": "\\bunrated\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "UNCUT", "match": "^Uncut$|version[ ._-]?integrale", "fields": ["editions", "filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "UNCENSORED", "match": "\\buncensored\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "DEFINITIVE", "match": "\\bdefinitive[ ._-]?(cut|edition)\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "SPECIAL ED", "match": "\\bspecial[ ._-]?edition\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "INTL CUT", "match": "\\binternational[ ._-]?(cut|version)\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "ALT CUT", "match": "\\balternat(e|ive)[ ._-]?(cut|version)\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "ASSEMBLY", "match": "\\bassembly[ ._-]?cut\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "PRODUCER CUT", "match": "\\bproducers?'?[ ._-]?cut\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "WORKPRINT", "match": "\\bworkprint\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "TV CUT", "match": "\\b(tv|television)[ ._-]?(cut|version)\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "B&W", "match": "black[ ._-]?(and|&)[ ._-]?(chrome|white)|\\bnoir[ ._-]?(edition|version)\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "DESPECIALIZED", "match": "\\bdespeciali[sz]ed\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "ANNIVERSARY", "match": "^Anniversary Edition$", "fields": ["editions"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "COLLECTOR", "match": "^Collector's Edition$", "fields": ["editions"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "DIAMOND", "match": "^Diamond Edition$", "fields": ["editions"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "PLATINUM", "match": "\\bplatinum[ ._-]?edition\\b", "fields": ["filename"], "group": "ed", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "THEATRICAL", "match": "^Theatrical$", "fields": ["editions"], "group": "ed", "color": "#5A5A5A", "border": "#2E2E2E"},
    {"label": "REMASTERED", "match": "^Remastered$|\\brestor(ed|ation)\\b", "fields": ["editions", "filename"], "group": "rem", "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "CRITERION", "match": "^Criterion Collection$|\\bcriterion\\b", "fields": ["editions", "filename", "folderName"], "color": "#C6A56B", "border": "#4A4A4A"},
    {"label": "OPEN MATTE", "match": "open[ ._-]?matte", "fields": ["filename", "folderName"], "color": "#EDE8DF", "border": "#2E2E2E"},
    {"label": "PROPER", "match": "\\b(repack|proper|rerip)\\d?\\b", "fields": ["filename"], "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "PACK", "match": "\\bS\\d{1,2}\\b(?![ ._-]?E\\d)|\\bcomplete\\b|\\bintegrale?\\b", "fields": ["filename", "folderName"], "color": "#8C8C8C", "border": "#2E2E2E"},
    {"label": "RD", "match": "^Ready RD$", "fields": ["rseMatched"], "group": "svc", "color": "#0E0E0E", "background": "#8C8C8C", "border": "#8C8C8C"},
    {"label": "TB", "match": "^Ready TB$", "fields": ["rseMatched"], "group": "svc", "color": "#0E0E0E", "background": "#8C8C8C", "border": "#8C8C8C"},
    {"label": "AD", "match": "^Ready AD$", "fields": ["rseMatched"], "group": "svc", "color": "#0E0E0E", "background": "#8C8C8C", "border": "#8C8C8C"},
    {"label": "EN", "match": "^Ready EN$", "fields": ["rseMatched"], "group": "svc", "color": "#0E0E0E", "background": "#8C8C8C", "border": "#8C8C8C"}
  ]
}
